APP_ENV=development
DEMO_MODE=true
LIVE_FETCH_ENABLED=false
ALLOW_INTERNAL_DATA_TO_EXTERNAL_AI=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=90
SOURCE_MAX_BYTES=1500000
PIPELINE_DB_PATH=/tmp/grantcurrent_pipeline.db
RAG_MAX_CONTEXT_CHARS=16000

# Optional external research workers. Secrets stay server-side.
# Local RAG works with no API key.
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.5
GEMINI_API_KEY=
GEMINI_RESEARCH_MODEL=gemini-3.8-flash

# Microsoft / Copilot: point this at your own Copilot Studio or Microsoft Foundry/Bing
# research-agent gateway. The gateway should accept JSON {query, allowed_domains,
# max_results, instruction} and return {summary, sources:[{url,title}]}.
MICROSOFT_RESEARCH_URL=
MICROSOFT_RESEARCH_TOKEN=

# Optional future connector; not required by this build.
TAVILY_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
